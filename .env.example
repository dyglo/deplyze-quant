# ─── Frontend (Vite) — exposed to the browser ─────────────────────────────
# Firebase config for the deplyze-quant project (or whichever Firebase project
# you point this app at).
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="deplyze-quant.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="deplyze-quant"
VITE_FIREBASE_STORAGE_BUCKET="deplyze-quant.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"

# Optional: override the local dev gateway URL (defaults to http://localhost:8080).
# VITE_DEV_GATEWAY_URL="http://localhost:8080"

# ─── Gateway (server-side only) — NEVER exposed to the browser ────────────
# In production these are set via gcloud / Secret Manager, e.g.
#   gcloud run services update deplyze-gateway --set-secrets=GEMINI_API_KEY=...
# For local dev they are read from this file by cloud-run/gateway/src/index.ts.

FIREBASE_PROJECT_ID="deplyze-quant"

GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Financial provider keys
FINNHUB_API_KEY="YOUR_FINNHUB_API_KEY"
ALPHA_VANTAGE_API_KEY="YOUR_ALPHA_VANTAGE_API_KEY"
TWELVE_DATA_API_KEY="YOUR_TWELVE_DATA_API_KEY"
TAVILY_API_KEY="YOUR_TAVILY_API_KEY"
SERPER_API_KEY="YOUR_SERPER_API_KEY"

# Optional gateway tuning
# ALLOWED_ORIGINS="http://localhost:5173,https://deplyze-quant.web.app"
# PORT=8080
