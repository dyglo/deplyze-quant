rules_version = '2';

// ─── Deplyze Quant — Firestore security rules ────────────────────────────────
// Hardened: 2026-05-29 (Stage 1 — tenant isolation)
//
// Tenancy model:
//   organizations/{orgId}                            — research desk (workspace).
//                                                      `ownerId` = creator uid.
//   memberships/{uid_orgId}                          — user ↔ org pivot.
//                                                      Deterministic id `${uid}_${orgId}`,
//                                                      fields { uid, orgId, role }.
//   sites/{siteId}                                   — projects, field `orgId`.
//   invites/{inviteId}                               — pending invites, field `orgId`.
//   workspaces/{orgId}/projects/{pid}/...            — server-written agent
//                                                      artifacts / briefings (Admin SDK).
//   workspaces/{orgId}/apiKeys/{provider}            — provider keys (SERVER-ONLY).
//   portfolios/{id} (+ holdings, transactions)       — simulated portfolios, field `uid`.
//   portfolioIntelligence/{id}                       — observations, field `portfolioId`.
//   customScenarios/{id}                             — stress scenarios, field `uid`.
//   providerCache / auditLogs                        — SERVER-ONLY.
//
// Access is org-scoped via membership. An owner fallback (organizations.ownerId)
// keeps owners from being locked out if a membership doc is ever missing
// (e.g. data created before the membership backfill). All artifact/briefing
// writes happen from the gateway / agents via the Admin SDK, which bypasses
// these rules; clients only read those documents.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // A *full* (non-anonymous) account. Anonymous guests carry a valid token so
    // `isSignedIn()` is true for them, but they must never write persisted data
    // (workspaces, portfolios, profiles, …). All client write paths below gate
    // on this so guest sessions can browse but never pollute Firestore.
    function isFullUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Membership pivot uses a deterministic id: `${uid}_${orgId}`.
    function isOrgMember(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId));
    }
    // Owner fallback — defense-in-depth against a missing membership doc so the
    // org creator can never lock themselves out of their own workspace.
    function isOrgOwner(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
    }
    function canAccessOrg(orgId) { return isOrgMember(orgId) || isOrgOwner(orgId); }

    // ─── Users ────────────────────────────────────────────────────────────
    // RESIDUAL: read stays broad because invite-by-email and member listing
    // query users by `email` / `orgId` from the client. User docs hold profile
    // data only (no secrets). Tightening this requires moving those lookups
    // server-side and is tracked for a later stage.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isFullUser() && request.auth.uid == userId;

      // Saved Historical Research investigations — owner-scoped, personal.
      match /historical_research/{investigationId} {
        allow read:        if isSignedIn() && request.auth.uid == userId;
        allow write, delete: if isFullUser() && request.auth.uid == userId;
      }
    }

    // ─── Memberships ──────────────────────────────────────────────────────
    // A user may always touch their own membership. Org members/owners may
    // manage memberships within their own org (invite an existing user / remove
    // a member / delete-workspace cleanup). No cross-org access.
    match /memberships/{membershipId} {
      allow read:   if isSignedIn()
        && (resource.data.uid == request.auth.uid || canAccessOrg(resource.data.orgId));
      allow create: if isFullUser()
        && (request.resource.data.uid == request.auth.uid || canAccessOrg(request.resource.data.orgId));
      allow update, delete: if isFullUser()
        && (resource.data.uid == request.auth.uid || canAccessOrg(resource.data.orgId));
    }

    // ─── Organizations ────────────────────────────────────────────────────
    // CRITICAL — list-query safety. WorkspaceContext runs two client queries:
    //   • owned   → query(organizations, where('ownerId','==',uid))
    //   • member  → query(organizations, where('__name__','in',[orgIds]))
    // A `list` rule can ONLY be proven safe from the candidate doc itself
    // (`resource.data` / the path wildcard) — a cross-document `get()` cannot
    // authorize a field-based list query. The previous rule authorised owners
    // via `isOrgOwner(orgId)` which `get()`s the org doc; that works for a
    // single `getDoc` but makes the owned-orgs LIST query fail with
    // "Missing or insufficient permissions" whenever the owner has no
    // membership doc (the exact owner-fallback case). We therefore authorise
    // the owner branch directly from `resource.data.ownerId`, which matches the
    // query filter and is provably safe for both get and list.
    match /organizations/{orgId} {
      allow read:   if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isOrgMember(orgId));
      allow create: if isFullUser() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isFullUser()
        && (resource.data.ownerId == request.auth.uid || isOrgMember(orgId));
      allow delete: if isFullUser() && resource.data.ownerId == request.auth.uid;
    }

    // ─── Workspaces — server-written subtree, org-scoped client reads ──────
    match /workspaces/{wid} {
      allow read, write: if canAccessOrg(wid);

      match /projects/{pid} {
        allow read, write: if canAccessOrg(wid);

        match /watchlists/{watchlistId} { allow read, write: if canAccessOrg(wid); }
        match /artifacts/{artifactId} {
          allow read:   if canAccessOrg(wid);
          allow create: if canAccessOrg(wid);
          // Any org member may update the mutable user-facing fields; full
          // updates are restricted to the original creator. Agent-written
          // artifacts have no createdBy, so the field-scoped branch is the
          // primary client update path.
          allow update: if canAccessOrg(wid) && (
            resource.data.get('createdBy', null) == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['saved', 'tags', 'title', 'body', 'updatedAt'])
          );
          allow delete: if canAccessOrg(wid)
            && resource.data.get('createdBy', null) == request.auth.uid
            && resource.data.source == 'user';
        }
        match /briefings/{briefingId} { allow read: if canAccessOrg(wid); }
        match /agentRuns/{runId} { allow read: if canAccessOrg(wid); }
        match /pins/{pinId} { allow read, write: if canAccessOrg(wid); }
        match /labSessions/{sessionId} { allow read, write: if canAccessOrg(wid); }
        match /copilotInsights/{insightId} { allow read, write: if canAccessOrg(wid); }
      }

      // Provider keys — server-only, never client-readable.
      match /apiKeys/{provider} { allow read, write: if false; }
    }

    // ─── Sites (active projects; scoped by `orgId` field) ──────────────────
    match /sites/{siteId} {
      allow read:           if canAccessOrg(resource.data.orgId);
      allow create:         if isFullUser() && canAccessOrg(request.resource.data.orgId);
      allow update, delete: if isFullUser() && canAccessOrg(resource.data.orgId);
    }

    // ─── Invites (scoped by `orgId` field) ─────────────────────────────────
    match /invites/{inviteId} {
      allow read:           if canAccessOrg(resource.data.orgId);
      allow create:         if isFullUser() && canAccessOrg(request.resource.data.orgId);
      allow update, delete: if isFullUser() && canAccessOrg(resource.data.orgId);
    }

    // ─── Portfolio Intelligence ───────────────────────────────────────────
    // Top-level collections scoped by `uid` on each document. Clients own their
    // own portfolio documents; no cross-user access.
    match /portfolios/{portfolioId} {
      allow read:   if isSignedIn() && request.auth.uid == resource.data.uid;
      allow write:  if isFullUser() && request.auth.uid == resource.data.uid;
      allow create: if isFullUser() && request.auth.uid == request.resource.data.uid;

      // Holdings + simulated transaction ledger inherit ownership from the
      // parent portfolio document (subcollections do NOT inherit parent rules).
      match /holdings/{holdingId} {
        allow read:  if isSignedIn()
          && get(/databases/$(database)/documents/portfolios/$(portfolioId)).data.uid == request.auth.uid;
        allow write: if isFullUser()
          && get(/databases/$(database)/documents/portfolios/$(portfolioId)).data.uid == request.auth.uid;
      }
      match /transactions/{transactionId} {
        allow read:  if isSignedIn()
          && get(/databases/$(database)/documents/portfolios/$(portfolioId)).data.uid == request.auth.uid;
        allow write: if isFullUser()
          && get(/databases/$(database)/documents/portfolios/$(portfolioId)).data.uid == request.auth.uid;
      }
    }

    // Observations reference a portfolio by id; ownership flows from that
    // parent portfolio's `uid`. (Queries always filter by `portfolioId`.)
    match /portfolioIntelligence/{observationId} {
      allow read:           if isSignedIn()
        && get(/databases/$(database)/documents/portfolios/$(resource.data.portfolioId)).data.uid == request.auth.uid;
      allow update, delete: if isFullUser()
        && get(/databases/$(database)/documents/portfolios/$(resource.data.portfolioId)).data.uid == request.auth.uid;
      allow create: if isFullUser()
        && get(/databases/$(database)/documents/portfolios/$(request.resource.data.portfolioId)).data.uid == request.auth.uid;
    }

    match /intelligenceWatchlists/{watchlistId} {
      allow read:  if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if isFullUser() && (
        resource.data.uid == request.auth.uid
        || request.resource.data.uid == request.auth.uid
      );
      allow create: if isFullUser() && request.resource.data.uid == request.auth.uid;
    }

    // ─── Custom stress scenarios (scoped by `uid`) ─────────────────────────
    match /customScenarios/{scenarioId} {
      allow read:           if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create:         if isFullUser() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isFullUser() && resource.data.uid == request.auth.uid;
    }

    // ─── V5 Personalization · low-latency mirrors ─────────────────────────
    // BigQuery is the source of truth. Firestore mirrors are scoped to a single
    // user under /users/{uid} so cross-user reads are impossible by construction.
    // personalizationProfile + savedBriefings (write side) are populated by the
    // gateway / engine via the Admin SDK (bypasses rules); clients only read.
    match /users/{userId}/personalizationProfile/{docId} {
      allow read:  if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }
    match /users/{userId}/investigations/{investigationId} {
      allow read:  if isSignedIn() && request.auth.uid == userId;
      allow write: if isFullUser() && request.auth.uid == userId;
    }
    match /users/{userId}/savedBriefings/{briefingId} {
      allow read:  if isSignedIn() && request.auth.uid == userId;
      allow write: if isFullUser() && request.auth.uid == userId;
    }
    match /users/{userId}/workflowMemory/{memoryId} {
      allow read:  if isSignedIn() && request.auth.uid == userId;
      allow write: if isFullUser() && request.auth.uid == userId;
    }
    match /users/{userId}/personalizationControls/{docId} {
      allow read:  if isSignedIn() && request.auth.uid == userId;
      allow write: if isFullUser() && request.auth.uid == userId;
    }

    // ─── Server-only collections ──────────────────────────────────────────
    match /providerCache/{key}  { allow read, write: if false; }
    match /auditLogs/{logId}    { allow read, write: if false; }
  }
}
