rules_version = '2';

// ─── Deplyze Quant — Firestore security rules ────────────────────────────────
//
// Tenancy model:
//   workspaces/{wid}                                 — research desk
//   workspaces/{wid}/projects/{pid}                  — strategy / portfolio
//   workspaces/{wid}/projects/{pid}/artifacts/{id}   — agent-generated insight
//   workspaces/{wid}/projects/{pid}/briefings/{id}   — institutional briefings
//   workspaces/{wid}/projects/{pid}/watchlists/{id}  — instrument watchlists
//   workspaces/{wid}/projects/{pid}/agentRuns/{id}   — agent execution log
//   workspaces/{wid}/apiKeys/{provider}              — provider keys (SERVER-ONLY)
//   memberships/{uid_wid}                            — user ↔ workspace pivot
//   organizations/{wid}                              — alias of workspaces for
//                                                      legacy membership lookups
//   providerCache/{key}                              — gateway response cache
//                                                      (SERVER-ONLY)
//   auditLogs/{id}                                   — gateway audit (SERVER-ONLY)
//
// All artifact/briefing writes happen from the gateway / agents via the Admin
// SDK, which bypasses these rules. Clients only ever read those documents.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function isMember(wid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/memberships/$(uid() + '_' + wid));
    }

    function isWorkspaceOwner(wid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(wid)) &&
        get(/databases/$(database)/documents/workspaces/$(wid)).data.ownerUid == uid();
    }

    // Legacy alias: WorkspaceContext writes to 'organizations' with field 'ownerId'
    function isOrgOwner(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == uid();
    }

    // ─── Users ────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && uid() == userId;
      allow delete: if false;
    }

    // ─── Memberships ──────────────────────────────────────────────────────
    match /memberships/{membershipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == uid();
      allow update, delete: if isSignedIn() && (
        resource.data.uid == uid() ||
        isWorkspaceOwner(resource.data.workspaceId)
      );
    }

    // ─── Workspaces ───────────────────────────────────────────────────────
    match /workspaces/{wid} {
      allow read: if isMember(wid) || isWorkspaceOwner(wid);
      allow create: if isSignedIn() && request.resource.data.ownerUid == uid();
      allow update, delete: if isWorkspaceOwner(wid);

      match /projects/{pid} {
        allow read: if isMember(wid) || isWorkspaceOwner(wid);
        allow create, update, delete: if isMember(wid) || isWorkspaceOwner(wid);

        match /watchlists/{watchlistId} {
          allow read: if isMember(wid) || isWorkspaceOwner(wid);
          allow create, update, delete: if isMember(wid) || isWorkspaceOwner(wid);
        }

        // Artifacts and briefings: server-written (Admin SDK), client-read only.
        match /artifacts/{artifactId} {
          allow read: if isMember(wid) || isWorkspaceOwner(wid);
          allow write: if false;
        }

        match /briefings/{briefingId} {
          allow read: if isMember(wid) || isWorkspaceOwner(wid);
          allow write: if false;
        }

        match /agentRuns/{runId} {
          allow read: if isMember(wid) || isWorkspaceOwner(wid);
          allow write: if false;
        }

        match /pins/{pinId} {
          allow read: if isMember(wid) || isWorkspaceOwner(wid);
          allow create: if (isMember(wid) || isWorkspaceOwner(wid))
            && request.resource.data.pinnedBy == uid();
          allow update: if (isMember(wid) || isWorkspaceOwner(wid))
            && resource.data.pinnedBy == uid();
          allow delete: if (isMember(wid) || isWorkspaceOwner(wid))
            && resource.data.pinnedBy == uid();
        }

        match /labSessions/{sessionId} {
          allow read: if isMember(wid) || isWorkspaceOwner(wid);
          allow create: if (isMember(wid) || isWorkspaceOwner(wid))
            && request.resource.data.savedBy == uid();
          allow update: if (isMember(wid) || isWorkspaceOwner(wid))
            && resource.data.savedBy == uid();
          allow delete: if (isMember(wid) || isWorkspaceOwner(wid))
            && resource.data.savedBy == uid();
        }

        match /copilotInsights/{insightId} {
          allow read: if isMember(wid) || isWorkspaceOwner(wid);
          allow create: if (isMember(wid) || isWorkspaceOwner(wid))
            && request.resource.data.savedBy == uid();
          allow update: if (isMember(wid) || isWorkspaceOwner(wid))
            && resource.data.savedBy == uid();
          allow delete: if (isMember(wid) || isWorkspaceOwner(wid))
            && resource.data.savedBy == uid();
        }
      }

      // Provider API keys: SERVER-ONLY. No client access at all.
      match /apiKeys/{provider} {
        allow read, write: if false;
      }
    }

    // ─── Legacy: organizations (alias of workspaces used by WorkspaceContext) ──
    // WorkspaceContext.tsx writes here with ownerId (not ownerUid)
    match /organizations/{orgId} {
      allow read: if isMember(orgId) || isOrgOwner(orgId);
      allow create: if isSignedIn() && request.resource.data.ownerId == uid();
      allow update: if isOrgOwner(orgId);
      allow delete: if isOrgOwner(orgId);
    }

    // ─── Legacy: sites (projects used by firestoreService) ────────────────
    // firestoreService.ts writes projects to /sites with orgId field
    match /sites/{siteId} {
      allow read: if isSignedIn() && (
        isMember(resource.data.orgId) || isOrgOwner(resource.data.orgId)
      );
      allow create: if isSignedIn() && (
        isMember(request.resource.data.orgId) || isOrgOwner(request.resource.data.orgId)
      );
      allow update, delete: if isSignedIn() && (
        isMember(resource.data.orgId) || isOrgOwner(resource.data.orgId)
      );
    }

    // ─── Server-only collections ──────────────────────────────────────────
    match /providerCache/{key}  { allow read, write: if false; }
    match /auditLogs/{logId}    { allow read, write: if false; }
  }
}
