rules_version = '2';

// ─── Deplyze Quant — Firestore security rules ────────────────────────────────
// Forced redeploy: 2026-05-18T12:28:00
//
// Tenancy model:
//   workspaces/{wid}                                 — research desk
//   workspaces/{wid}/projects/{pid}                  — strategy / portfolio
//   workspaces/{wid}/projects/{pid}/artifacts/{id}   — agent-generated insight
//   workspaces/{wid}/projects/{pid}/briefings/{id}   — institutional briefings
//   workspaces/{wid}/projects/{pid}/watchlists/{id}  — instrument watchlists
//   workspaces/{wid}/projects/{pid}/agentRuns/{id}   — agent execution log
//   workspaces/{wid}/apiKeys/{provider}              — provider keys (SERVER-ONLY)
//   memberships/{uid_wid}                            — user ↔ workspace pivot
//   organizations/{wid}                              — alias of workspaces for
//                                                      legacy membership lookups
//   providerCache/{key}                              — gateway response cache
//                                                      (SERVER-ONLY)
//   auditLogs/{id}                                   — gateway audit (SERVER-ONLY)
//
// All artifact/briefing writes happen from the gateway / agents via the Admin
// SDK, which bypasses these rules. Clients only ever read those documents.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // ─── Users ────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    // ─── Memberships ──────────────────────────────────────────────────────
    match /memberships/{membershipId} {
      allow read, write: if isSignedIn();
    }

    // ─── Workspaces ───────────────────────────────────────────────────────
    match /workspaces/{wid} {
      allow read, write: if isSignedIn();

      match /projects/{pid} {
        allow read, write: if isSignedIn();

        match /watchlists/{watchlistId} { allow read, write: if isSignedIn(); }
        match /artifacts/{artifactId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn();
          // Any workspace member may update the mutable user-facing fields
          // (saved state, tags, title, body). Full updates are restricted to the
          // original creator. Agent-written artifacts have no createdBy so the
          // field-scoped branch is the primary path for client updates.
          allow update: if isSignedIn() && (
            resource.data.get('createdBy', null) == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['saved', 'tags', 'title', 'body', 'updatedAt'])
          );
          allow delete: if isSignedIn()
            && resource.data.get('createdBy', null) == request.auth.uid
            && resource.data.source == 'user';
        }
        match /briefings/{briefingId} { allow read: if isSignedIn(); }
        match /agentRuns/{runId} { allow read: if isSignedIn(); }
        match /pins/{pinId} { allow read, write: if isSignedIn(); }
        match /labSessions/{sessionId} { allow read, write: if isSignedIn(); }
        match /copilotInsights/{insightId} { allow read, write: if isSignedIn(); }
      }
    }

    // ─── Organizations (Legacy alias) ─────────────────────────────────────
    match /organizations/{orgId} {
      allow read, write: if isSignedIn();
    }

    // ─── Sites (Legacy projects) ──────────────────────────────────────────
    match /sites/{siteId} {
      allow read, write: if isSignedIn();
    }

    // ─── Invites ──────────────────────────────────────────────────────────
    match /invites/{inviteId} {
      allow read, write: if isSignedIn();
    }

    // ─── Portfolio Intelligence ───────────────────────────────────────────
    // Top-level collections scoped by uid + workspaceId on each document.
    // Clients own their own portfolio documents; no cross-user access.
    match /portfolios/{portfolioId} {
      allow read, write: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow create:      if isSignedIn() && request.auth.uid == request.resource.data.uid;

      match /holdings/{holdingId} {
        allow read, write: if isSignedIn();
      }
    }

    match /portfolioIntelligence/{observationId} {
      allow read, write: if isSignedIn();
    }

    match /intelligenceWatchlists/{watchlistId} {
      allow read, write: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || request.resource.data.uid == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // ─── Custom stress scenarios ──────────────────────────────────────────
    // Simple auth gate — uid filtering is enforced client-side on the query.
    match /customScenarios/{scenarioId} {
      allow read, write: if isSignedIn();
    }

    // ─── V5 Personalization · low-latency mirrors ─────────────────────────
    // BigQuery is the source of truth (raw_app.user_events,
    // features.user_profile_daily, artifacts.investigation_memory). Firestore
    // mirrors are intentionally scoped to a single user under /users/{uid}
    // so client reads stay cheap and security stays strict — no
    // cross-user reads possible by construction.
    //
    // personalizationProfile + savedBriefings (write side) are populated by
    // the gateway / engine via the Admin SDK (bypasses rules). Clients only
    // read them. Investigations + workflowMemory + personalizationControls
    // are user-owned for read+write under their own /users/{uid} path.
    match /users/{userId}/personalizationProfile/{docId} {
      allow read:  if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }
    match /users/{userId}/investigations/{investigationId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/savedBriefings/{briefingId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/workflowMemory/{memoryId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/personalizationControls/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ─── Server-only collections ──────────────────────────────────────────
    match /providerCache/{key}  { allow read, write: if false; }
    match /auditLogs/{logId}    { allow read, write: if false; }
  }
}
