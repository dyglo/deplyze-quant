# ─── Quant Engine — Environment Variables ─────────────────────────────────────
# Copy to .env.local for local development.
# In Cloud Run, set these as environment variables (not in source code).
# NEVER commit this file with real keys.

# ─── GCP ─────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=deplyze-quant
BIGQUERY_LOCATION=US
QUANT_ENGINE_ENV=development

# ─── Provider API keys ────────────────────────────────────────────────────────
POLYGON_API_KEY=
FMP_API_KEY=
EODHD_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# ─── Optional ─────────────────────────────────────────────────────────────────
# ALLOWED_ORIGINS_RAW=https://deplyze-quant.web.app,https://deplyze-quant.firebaseapp.com
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
